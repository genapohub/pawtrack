# 宠迹 PawTrack 生产环境变量模板
# 复制为 .env 并填入真实值后再执行 docker compose -f docker-compose.prod.yml up -d
# ⚠️ 切勿将真实 .env 提交到仓库

# ── 数据库 ─────────────────────────────
POSTGRES_DB=pawtrack
POSTGRES_USER=pawtrack
POSTGRES_PASSWORD=请替换为强随机密码

# ── Redis ─────────────────────────────
REDIS_PASSWORD=请替换为强随机密码

# ── MongoDB ─────────────────────────────
MONGO_USER=pawtrack
MONGO_PASSWORD=请替换为强随机密码

# ── RabbitMQ ─────────────────────────────
RABBITMQ_USER=pawtrack
RABBITMQ_PASSWORD=请替换为强随机密码

# ── 后台管理员 ─────────────────────────────
ADMIN_PASSWORD=请替换为强随机密码

# ── 微信（可选，未接入留空）─────────────────
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ── GHCR 镜像拉取（docker-compose.prod.yml 用）─────────────
# 你的 GitHub 用户名/组织名（小写），用于拼接 ghcr.io 镜像地址
GITHUB_OWNER=your-github-owner

# ── 监控告警（可选）────────────────────────────
# Sentry 错误上报 DSN（留空则不启用）
SENTRY_DSN=
# 告警 webhook（生产环境关键错误/慢请求推送，留空则仅记日志）
ALERT_WEBHOOK_URL=

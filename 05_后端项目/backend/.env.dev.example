# 宠迹 PawTrack — 本地开发环境配置模板
# 用法：复制为 backend/.env（后端读取）即可本地裸跑后端
# 基础设施（DB/Redis/Mongo/MQTT）通过 `make infra` 或 docker compose -f docker-compose.infra.yml up -d 启动

# 环境标识（dev=本地开发，自动生成临时 JWT 密钥、DEBUG 开启）
ENV=dev
DEBUG=true

# 数据库（infra compose 暴露到 localhost:5432）
DATABASE_URL=postgresql+asyncpg://pawtrack:pawtrack_dev@localhost:5432/pawtrack

# Redis（localhost:6379）
REDIS_URL=redis://localhost:6379/0

# MongoDB（localhost:27017）
MONGODB_URL=mongodb://pawtrack:pawtrack_dev@localhost:27017/pawtrack

# RabbitMQ（localhost:5672）
RABBITMQ_URL=amqp://pawtrack:pawtrack_dev@localhost:5672/

# MQTT（localhost:1883）
MQTT_BROKER_URL=mqtt://localhost:1883

# JWT 密钥路径（dev 可留空，自动生成临时密钥；如需持久化可生成后填入）
JWT_PRIVATE_KEY_PATH=/app/keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/app/keys/jwt_public.pem

# 后台管理员（dev 默认密码，仅本地）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=pawtrack_admin_2026

# 第三方（dev 可留空）
AMAP_API_KEY=
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 监控告警（dev 通常留空）
SENTRY_DSN=
ALERT_WEBHOOK_URL=

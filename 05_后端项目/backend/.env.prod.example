# 宠迹 PawTrack — 生产环境配置模板
# ⚠️ 切勿提交真实值！复制为 backend/.env.prod 并填入强随机值
# 生产启动：ENV=prod 且所有关键变量必须注入，否则后端启动报错

# 环境标识
ENV=prod
DEBUG=false

# 数据库（生产地址，禁止 localhost）
DATABASE_URL=postgresql+asyncpg://pawtrack:请替换强密码@postgres:5432/pawtrack

# Redis（生产需密码）
REDIS_URL=redis://:请替换强密码@redis:6379/0

# MongoDB（生产需密码）
MONGODB_URL=mongodb://pawtrack:请替换强密码@mongodb:27017/pawtrack

# RabbitMQ（生产需密码）
RABBITMQ_URL=amqp://pawtrack:请替换强密码@rabbitmq:5672/

# MQTT
MQTT_BROKER_URL=mqtt://emqx:1883

# JWT 密钥（生产必须挂载真实密钥文件，否则启动报错）
JWT_PRIVATE_KEY_PATH=/app/keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/app/keys/jwt_public.pem

# 后台管理员（生产必须改强密码，默认密码会被拒绝）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请替换为强随机密码

# 第三方
AMAP_API_KEY=
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 监控告警
SENTRY_DSN=
ALERT_WEBHOOK_URL=
